knitr::opts_chunk$set(echo = TRUE)
packages<-c("dr4pl","ggplot2","sysfonts","dplyr","knitr")
# Install packages not yet installed
installed_packages <- packages %in% rownames(installed.packages())
if (any(installed_packages == FALSE)) {
install.packages(packages[!installed_packages])
}
# Packages loading
invisible(lapply(packages, library, character.only = TRUE))
#Formatting
font_add("Arial","arial.ttf")
name<-c(1.000, 0.861, 0.722, 0.639, 0.500, 0.361, 0.278, 0.139, 0.000)
hex<-c("#2B38FF", "#231F20", "#E57406", "#787878", "#FA08FF", "#AB08FC", "#EC1C24", "#9D0170", "#08C5F7")
key<-setNames(hex,name)
options(scipen=999)
#Import Data
two<-read.csv("C:/Users/treze/Downloads/precisedosecalculations6_6to1and2_6to1/48hpf_DoseSummary_ToTeresa_21july25.csv")[,1:7]
coloc<-read.csv("C:/Users/treze/Downloads/precisedosecalculations6_6to1and2_6to1/48hpf_DoseCorrelate_ToTeresa_21july25.csv")[,1:5]
colnames(coloc)[2]<-"Spearmans"
six<-read.csv("C:/Users/treze/Downloads/precisedosecalculations6_6to1and2_6to1/6dpf_DoseSummary_ToTeresa_21july25.csv")
six<-remove_missing(six)
colnames(six)[3]<-"MyoCSA"
width26<- read.csv("C:/Users/treze/Downloads/26hpf_DoseSummary_ToTeresa_23july25.csv")[,1:5]
colnames(width26)[2:5]<-c("Width","Dose.2.6.1","Dose.6.6.1","Dose1.1")
#Models
#Naming convention: phenotype_h/dpf_ratio
width_48hpf_2.6_1   <-dr4pl(data=two,dose=Dose.2.6.1,response=Width,method.init="logistic")
afrac_48hpf_2.6_1   <-dr4pl(data=two,dose=Dose.2.6.1,response=Actin.Fraction,method.init="logistic")
myhcfrac_48hpf_2.6_1<-dr4pl(data=two,dose=Dose.2.6.1,response=MyHC.Fraction,method.init="logistic")
width_6dpf_2.6_1   <-dr4pl(data=six,dose=Dose.2.6.1,response=Width,method.init="logistic")
csa_6dpf_2.6_1      <-dr4pl(data=six,dose=Dose.2.6.1,response=Total.CSA,method.init="logistic")
mycsa_6dpf_2.6_1    <-dr4pl(data=six,dose=Dose.2.6.1,response=MyoCSA,method.init="logistic")
coloc_2dpf_2.6_1    <-dr4pl(data=coloc,dose=Dose.2.6.1,response=Spearmans,method.init="logistic")
width_26hpf_2.6_1   <-dr4pl(data=width26,dose=Dose.2.6.1,response=Width,method.init="logistic")
parameters<-rbind(
width_48hpf_2.6_1$parameters,
afrac_48hpf_2.6_1$parameters,
myhcfrac_48hpf_2.6_1$parameters,
width_6dpf_2.6_1$parameters,
mycsa_6dpf_2.6_1$parameters,
coloc_2dpf_2.6_1$parameters,
width_26hpf_2.6_1$parameters)
models<-c("Width 48 hpf","F-actin Fraction, 48 hpf","MyHC Fraction, 48hpf","Width, 6dpf","% Myofibrillar, 6dpf","Colocalization, 48hdpf","Width, 26hpf")
table<-cbind.data.frame(models,parameters)
table
r<-c(
sum(residuals(width_48hpf_2.6_1)^2),
sum(residuals(afrac_48hpf_2.6_1)^2),
sum(residuals(myhcfrac_48hpf_2.6_1)^2),
sum(residuals(width_6dpf_2.6_1)^2),
sum(residuals(mycsa_6dpf_2.6_1)^2),
sum(residuals(coloc_2dpf_2.6_1)^2),
sum(residuals(width_26hpf_2.6_1)^2))
t<-c(
sum(width_48hpf_2.6_1$data$Response-mean(width_48hpf_2.6_1$data$Response)^2),
sum(afrac_48hpf_2.6_1$data$Response-mean(afrac_48hpf_2.6_1$data$Response)^2),
sum(myhcfrac_48hpf_2.6_1$data$Response-mean(myhcfrac_48hpf_2.6_1$data$Response)^2),
sum(width_6dpf_2.6_1$data$Response-mean(width_6dpf_2.6_1$data$Response)^2),
sum(mycsa_6dpf_2.6_1$data$Response-mean(mycsa_6dpf_2.6_1$data$Response)^2),
sum(coloc_2dpf_2.6_1$data$Response-mean(coloc_2dpf_2.6_1$data$Response)^2),
sum(width_26hpf_2.6_1$data$Response-mean(width_26hpf_2.6_1$data$Response)^2))
R2<-1-(r/t)
R2
table<-cbind.data.frame(table,R2)
table
colnames(table)<-c("Phenotype","UpperLimit","EC50","Slope","LowerLimit","Linear Style R2")
table
table[c(7,1,4,5,2,3,6),c(1,6,4,3,5,2)]
kable(table[c(7,1,4,5,2,3,6),c(1,6,4,3,5,2)],row.names=FALSE)
kable(table[c(7,1,4,5,2,3,6),c(1,6,4,3,5,2)],row.names=FALSE)
